    "sections": [
      {
        "id": "feature-motor",
        "type": "text_image",
        "title": "292cc — Motor DOHC com Injeção Eletrónica",
        "description": "A KLX 300 é movida por um motor monocilíndrico de 292 cc, DOHC, 4 válvulas, arrefecido a líquido, com taxa de compressão 11.1:1. Entrega 25.0 hp a 8.000 rpm e 17.7 lb-ft de binário a 7.000 rpm. Sistema DFI® com corpo de acelerador Keihin de 34 mm, ignição CDI e transmissão de 6 velocidades. Ideal para uso misto (asfalto e terra) com excelente relação peso/potência.",
        "image": "/images/motorcycles/Kawasaki/KLX/300/galeria-1.avif",
        "reversed": false
      },
      {
        "id": "feature-handling",
        "type": "text_image",
        "title": "Suspensão Invertida de 43 mm e Travões a Disco",
        "description": "Suspensão dianteira: forcada invertida de 43 mm com ajuste de compressão, curso 10.0 in. Traseira: Uni-Trak® com reservatório piggyback, ajuste de compressão, extensão e pré-carga, curso 9.1 in. Travões: disco dianteiro 250 mm (pinça duplo pistão), traseiro 240 mm (pinça simples). Pneus 3.0x21 dianteiro e 4.6x18 traseiro.",
        "image": "/images/motorcycles/Kawasaki/KLX/300/galeria-2.avif",
        "reversed": true
      },
      {
        "id": "feature-tecnologia",
        "type": "text_image",
        "title": "Equipamento Dual‑Sport Completo",
        "description": "A KLX 300 vem equipada com farol em LED, painel digital, e quadro tubular semi‑duplo berço. A suspensão de longo curso e os pneus mistos permitem explorar tanto estradas pavimentadas quanto trilhas leves.",
        "image": "/images/motorcycles/Kawasaki/KLX/300/galeria-3.avif",
        "reversed": false
      },
      {
        "id": "feature-design",
        "type": "text_image",
