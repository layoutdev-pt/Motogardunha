    "sections": [
      {
        "id": "feature-motor",
        "type": "text_image",
        "title": "144cc — Motor Monocilíndrico com Embreagem Manual",
        "description": "A KLX 140R F é movida por um motor monocilíndrico de 144 cc, SOHC, 2 válvulas, arrefecido a ar, com carburador Keihin PB20. Entrega 11.1 hp a 8.000 rpm e 8.9 lb-ft de binário a 6.000 rpm. Transmissão de 5 velocidades com embreagem manual. Ideal para jovens e adultos que buscam uma moto leve e ágil para trilhas.",
        "image": "/images/motorcycles/Kawasaki/KLX/140R_F/galeria-1.avif",
        "reversed": false
      },
      {
        "id": "feature-handling",
        "type": "text_image",
        "title": "Suspensão Uni-Trak® e Pneus de Grande Diâmetro",
        "description": "Suspensão dianteira: forcada telescópica de 33 mm com curso 7.5 in. Traseira: Uni-Trak® com amortecedor piggyback, ajuste de extensão (20 vias) e pré-carga, curso 7.9 in. Travões: disco dianteiro 220 mm (pinça duplo pistão), traseiro 186 mm (pinça simples). Pneus 2.75x21 dianteiro e 4.10x18 traseiro.",
        "image": "/images/motorcycles/Kawasaki/KLX/140R_F/galeria-2.avif",
        "reversed": true
      },
      {
        "id": "feature-tecnologia",
        "type": "text_image",
        "title": "Suspensão de Alta Performance",
        "description": "A versão F (Grandes Rodas) oferece suspensão traseira Uni-Trak® com ajuste de extensão de alta performance, ideal para terrenos mais exigentes. Quadro perimetral de aço de alta resistência.",
        "image": "/images/motorcycles/Kawasaki/KLX/140R_F/lifestyle-1.avif",
        "reversed": false
